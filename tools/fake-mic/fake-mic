#!/usr/bin/env bash
# Launch the Fake Ultramic GUI using the repo's Python venv.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$here/../.." && pwd)"
py="$repo_root/.venv/bin/python"
if [[ ! -x "$py" ]]; then
    echo "Error: venv python not found at $py" >&2
    echo "Create the venv and 'pip install PyQt6 pyalsaaudio' first." >&2
    exit 1
fi
exec "$py" "$here/fake_mic_gui.py" "$@"
